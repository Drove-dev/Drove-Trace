# ─── Database ───────────────────────────────────────────
DB_HOST=db          # 'localhost' if running outside Docker, 'db' inside Docker
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=               # your PostgreSQL password
DB_NAME=db_name

# ─── Server ─────────────────────────────────────────────
PORT=3000
HOST_API=http://localhost:3000/api

# ─── Auth ───────────────────────────────────────────────
JWT_SECRET=                # min 32 chars recommended, e.g. openssl rand -hex 32